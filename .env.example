# Copy to .env and adjust. Every value has a working default for the docker-compose setup,
# except LLM_API_KEY (needed only for the chatbot's generated answers).

# --- MongoDB (source of truth)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=dishcovery

# --- Cassandra (activity time series)
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=dishcovery
CASSANDRA_USER=
CASSANDRA_PASSWORD=

# --- Dgraph (social / taste graph), gRPC port
DGRAPH_HOST=localhost:9080

# --- ChromaDB (vector search)
# persistent = local folder (default), http = Chroma server (docker compose --profile chroma-server up -d)
CHROMA_MODE=persistent
CHROMA_PATH=./.chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
# all-MiniLM-L6-v2 = 384-d sentence embeddings, bundled by Chroma as ONNX (no PyTorch needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# a passage counts as relevant only if its cosine distance is <= this value
CHROMA_MAX_DISTANCE=0.65

# --- LLM for the RAG chatbot: any OpenAI-compatible /chat/completions endpoint
# Groq (free key at console.groq.com):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2  LLM_API_KEY=ollama
LLM_TIMEOUT=60
# English, Spanish... or auto (same language as the question)
LLM_ANSWER_LANGUAGE=English

# --- Client
SESSION_HOURS=24
# "near me" reference point (ITESO campus)
DEFAULT_LON=-103.4160
DEFAULT_LAT=20.6075
